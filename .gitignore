# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.eggs/
venv/
.venv/
env/

# 打包产物（PyInstaller 输出 + 源码归档，不入库；CredentialVault.spec 与 scripts/*.py 是构建配置，保留追踪）
release/

# 中间产物目录（不入库）
tmp/

# Node / Frontend
frontend/node_modules/
frontend/dist/
frontend/.vite/

# Runtime data（用户数据，不入库）
data/
*.db
*.db-wal
*.db-shm
master.key

# 插件启用/禁用状态（本机运行时状态，不入库；发行包也不带它）
plugins/.state.json*
plugins/.model_cache.json*

# 构建时生成（commit hash 注入，由 scripts/build.py 写；不入库）
backend/_build_info.py

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
desktop.ini

# 环境变量
.env
.env.local
