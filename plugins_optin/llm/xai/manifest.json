{
  "name": "xAI",
  "version": "1.0.0",
  "credential_type": "llm_xai",
  "author": "Credential Vault",
  "description": "验证 xAI（Grok）API Key 有效性",
  "icon": "🚀",
  "fields": [
    {
      "key": "base_url",
      "label": "Base URL",
      "type": "url",
      "required": false,
      "placeholder": "留空使用默认地址",
      "default": "https://api.x.ai/v1",
      "hint": "OpenAI 兼容网关地址，留空使用默认。"
    },
    {
      "key": "api_key",
      "label": "API Key",
      "type": "password",
      "required": true,
      "sensitive": true,
      "placeholder": "xai-...",
      "hint": "xAI 控制台生成的 API Key，验证时仅本地发送。"
    },
    {
      "key": "notes",
      "label": "备注",
      "type": "textarea",
      "required": false,
      "hint": "可选备注。"
    }
  ]
}
