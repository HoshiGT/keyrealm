{
  "name": "华为云",
  "version": "1.0.0",
  "credential_type": "cloud_huaweicloud",
  "author": "Keyrealm",
  "description": "验证华为云 AK/SK 有效性（OBS ListBuckets，只读），并提供身份、区域、云主机与对象存储的只读查询操作",
  "icon": "logo.svg",
  "fields": [
    {
      "key": "access_key_id",
      "label": "Access Key ID (AK)",
      "type": "text",
      "required": true,
      "sensitive": true,
      "placeholder": "HPUA…"
    },
    {
      "key": "secret_access_key",
      "label": "Secret Access Key (SK)",
      "type": "password",
      "required": true,
      "sensitive": true,
      "placeholder": "请输入 SK"
    },
    {
      "key": "region",
      "label": "OBS 区域",
      "type": "text",
      "required": false,
      "default": "ap-southeast-3",
      "placeholder": "ap-southeast-3",
      "hint": "只读校验走对象存储列举桶接口（obs.<区域>.myhuaweicloud.com），此栏即签名与访问域名用的区域。留空按 ap-southeast-3。"
    },
    {
      "key": "project_id",
      "label": "项目 ID (project_id)",
      "type": "text",
      "required": false,
      "sensitive": false,
      "placeholder": "选填，如 0a1b2c3d4e5f4a3b2c1d0e9f8a7b6c5d",
      "hint": "仅「云主机实例列表」需要（华为 ECS 接口路径必须带 project_id）。留空时查 ECS 会先只读查询 IAM 项目列表，按区域自动推断，无副作用；也可从「区域列表」的「项目 ID」列复制。"
    },
    {
      "key": "notes",
      "label": "备注",
      "type": "textarea",
      "required": false
    }
  ]
}
