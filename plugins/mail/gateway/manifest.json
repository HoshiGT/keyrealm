{
  "name": "短信服务商",
  "version": "1.0.2",
  "credential_type": "sms_gateway",
  "author": "Keyrealm",
  "description": "短信网关 / 接码服务商凭据；字段按各厂商叫法通用化，选定服务商后用它的只读接口校验",
  "icon": "📲",
  "batch_verify": false,
  "fields": [
    {
      "key": "vendor",
      "label": "服务商",
      "type": "select",
      "required": true,
      "default": "unspecified",
      "options": [
        { "value": "unspecified", "label": "（未指定 / 其他）" },
        { "value": "nxcloud", "label": "nxcloud（appKey / secretKey）" },
        { "value": "infobip_in", "label": "Infobip 印度（apiKey）" },
        { "value": "infobip_hk", "label": "Infobip 香港 / info-bip-hk（apiKey）" },
        { "value": "cm", "label": "CM / cmtelecom（productToken）" },
        { "value": "buka", "label": "buka / itniotech（apiKey / apiSecret）" },
        { "value": "laaffic", "label": "laaffic（apiKey / secretKey / appId）" },
        { "value": "engagelab", "label": "WhatsApp Engagelab（apiKey / apiSecret）" },
        { "value": "ultramsg", "label": "Ultramsg（instanceId / token）" }
      ],
      "hint": "按所选厂商的只读接口校验。Ultramsg 对任意实例 / 口令都返回同一段文案，只能报「未验证」。"
    },
    {
      "key": "app_key",
      "label": "标识 / 账号",
      "type": "text",
      "required": false,
      "sensitive": true,
      "placeholder": "见上方服务商一栏的括注"
    },
    {
      "key": "app_secret",
      "label": "密钥 / 口令",
      "type": "password",
      "required": false,
      "sensitive": true,
      "placeholder": "见上方服务商一栏的括注"
    },
    {
      "key": "extra_params",
      "label": "附加参数（name=value，用 ; 分隔）",
      "type": "text",
      "required": false,
      "sensitive": true,
      "placeholder": "appId=1000"
    },
    {
      "key": "notes",
      "label": "备注",
      "type": "textarea",
      "required": false
    }
  ]
}
