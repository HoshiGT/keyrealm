{
  "name": "DuckDNS",
  "version": "1.0.0",
  "credential_type": "dns_duckdns",
  "author": "Credential Vault",
  "description": "验证 DuckDNS Token 与域名：会先把解析写入 1.1.1.1 确认生效，再还原为原值（有写副作用，仅支持手动单个验证）",
  "icon": "logo.png",
  "batch_verify": false,
  "fields": [
    {
      "key": "token",
      "label": "Token",
      "type": "password",
      "required": true,
      "sensitive": true,
      "placeholder": "DuckDNS 账号 Token"
    },
    {
      "key": "domain",
      "label": "域名",
      "type": "text",
      "required": true,
      "placeholder": "xxx.duckdns.org"
    },
    {
      "key": "notes",
      "label": "备注",
      "type": "textarea",
      "required": false
    }
  ]
}
