{
  "name": "百度文心",
  "version": "1.0.0",
  "credential_type": "llm_wenxin",
  "author": "Credential Vault",
  "description": "验证 百度文心 API Key 有效性（凭证格式 API_KEY|SECRET_KEY）",
  "icon": "logo.png",
  "fields": [
    {
      "key": "base_url",
      "label": "Base URL",
      "type": "url",
      "required": false,
      "placeholder": "留空使用默认地址",
      "default": "https://aip.baidubce.com"
    },
    {
      "key": "api_key",
      "label": "API Key",
      "type": "password",
      "required": true,
      "sensitive": true,
      "placeholder": "API_KEY|SECRET_KEY"
    },
    {
      "key": "probe_chat",
      "label": "余额未知时发一次对话探测",
      "type": "checkbox",
      "required": false,
      "hint": "验证会额外发一次对话请求实测账户是否可用（会消耗极少量额度）。默认关闭。文心的免费档模型不计费、看不出欠费，因此自动选型只挑付费档。"
    },
    {
      "key": "probe_model",
      "label": "探测使用的模型",
      "type": "model",
      "required": false,
      "placeholder": "留空自动选择",
      "hint": "留空 = 自动用 ernie-3.5-8k（付费档里最便宜）。可填：ernie-4.0-8k、ernie-3.5-8k、ernie-speed-8k、ernie-lite-8k、ernie-tiny-8k。"
    },
    {
      "key": "notes",
      "label": "备注",
      "type": "textarea",
      "required": false
    }
  ]
}
