{
  "name": "DeepSeek",
  "version": "1.0.0",
  "credential_type": "llm_deepseek",
  "author": "Credential Vault",
  "description": "验证 DeepSeek API Key 有效性，支持余额查询",
  "icon": "logo.png",
  "fields": [
    {
      "key": "base_url",
      "label": "Base URL",
