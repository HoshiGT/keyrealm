{
  "name": "LLM API Key",
  "version": "2.0.0",
  "credential_type": "llm_api_key",
  "author": "Credential Vault",
  "description": "验证 LLM 对话模型 API Key 有效性，支持 OpenAI、Anthropic、DeepSeek、OpenRouter、Gemini、MiniMax、NVIDIA NIM、Moonshot、硅基流动、阿里百炼、华为 MaaS、智谱 GLM、字节豆包、阿里通义、百度文心及各类 OpenAI/Anthropic 兼容中转",
  "icon": "🤖",
  "fields": [
    {
      "key": "vendor",
      "label": "厂商",
      "type": "select",
      "required": true,
      "options": [
        "openai",
        "anthropic",
        "deepseek",
        "openrouter",
        "gemini",
        "minimax",
        "nvidia",
        "moonshot",
        "siliconflow",
        "dashscope",
        "huawei_maas",
        "glm",
        "glm_anthropic",
        "doubao",
        "tongyi",
        "wenxin",
        "openai_compatible",
        "anthropic_compatible"
      ],
      "default": "openai"
    },
    {
      "key": "base_url",
      "label": "Base URL",
      "type": "url",
      "required": false,
      "placeholder": "留空使用厂商默认地址"
    },
    {
      "key": "api_key",
      "label": "API Key",
      "type": "password",
      "required": true,
      "sensitive": true,
      "placeholder": "sk-..."
    },
    {
      "key": "notes",
      "label": "备注",
      "type": "textarea",
      "required": false
    }
  ]
}
